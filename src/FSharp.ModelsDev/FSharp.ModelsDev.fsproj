<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FSharp.ModelsDev</RootNamespace>
    <PackageId>FSharp.ModelsDev</PackageId>
    <Description>F# LLM API SDK: standalone chat client, Models.dev offline catalog, Microsoft.Extensions.AI IChatClient adapter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Contracts.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Seams.fs" />
    <Compile Include="BackendCore.fs" />
    <Compile Include="CatalogTypes.fs" />
    <Compile Include="ProviderAuthTypes.fs" />
    <Compile Include="ProviderOptions.fs" />
    <Compile Include="IModelCatalog.fs" />
    <Compile Include="ModelCatalogQuery.fs" />
    <Compile Include="Generated/ProviderIndex.g.fs" />
    <Compile Include="Generated/ModelIndex.g.fs" />
    <Compile Include="SnapshotCatalog.fs" />
    <Compile Include="Sse.fs" />
    <Compile Include="OpenAICompatible.fs" />
    <Compile Include="CapabilityPolicy.fs" />
    <Compile Include="Credentials.fs" />
    <Compile Include="ProviderAuthRuntime.fs" />
    <Compile Include="GrokAuth.fs" />
    <Compile Include="OpenRouterAuth.fs" />
    <Compile Include="KimiCodeAuth.fs" />
    <Compile Include="GitHubCopilotAuth.fs" />
    <Compile Include="KiloAuth.fs" />
    <Compile Include="ClinePassAuth.fs" />
    <Compile Include="ProviderAuthAdapters.fs" />
    <Compile Include="ProviderAuthClient.fs" />
    <Compile Include="GoogleOAuth.fs" />
    <Compile Include="Gemini.fs" />
    <Compile Include="Anthropic.fs" />
    <Compile Include="Antigravity.fs" />
    <Compile Include="OpenAIResponses.fs" />
    <Compile Include="OpenAIChatBackend.fs" />
    <Compile Include="KimiCodeBackend.fs" />
    <Compile Include="ProviderRegistry.fs" />
    <Compile Include="ChatClient.fs" />
    <Compile Include="ProviderFactory.fs" />
    <Compile Include="MEAi/Conversions.fs" />
    <Compile Include="MEAi/ModelsDevChatClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../catalog/models.snapshot.json">
      <LogicalName>FSharp.ModelsDev.models.snapshot.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
  </ItemGroup>

</Project>
